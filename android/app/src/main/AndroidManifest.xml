<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- on the car's screen: the phone's speed tells when the car is parked (videos play only then) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- what Android Auto looks for before it shows an app's own screens on the car's display (Android 15 and later) -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />

    <!-- one app for phones, foldables and Android TV -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- cars with Google built in (Android Automotive): the car itself blocks TubeView's screens (videos) while driving -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <application
        android:name=".TubeViewApp"
        android:appCategory="game"
        android:label="TubeView"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.TubeView"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <!-- Android Auto: TubeView is a music app there -->
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <!-- TubeView's screens on the car's display, as AA Browser (github.com/kododake/AABrowser) gets there: Android
             Auto shows apps that say this, and that are in the "game" category (above; Android Auto lets games use the
             car's screen when parked). An app with a music service is shown as a music app instead, so that's switched
             off for this (Settings → Android Auto). They aren't usable while driving all the same: ParkedGuard covers them while
             the car moves, and pauses videos. -->
        <meta-data android:name="distractionOptimized" android:value="true" />
        <meta-data android:name="androidx.car.app.minCarApiLevel" android:value="7" />

        <!-- configChanges: folding, rotating or resizing must not reload the page (or stop the music) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- the car's app launcher (Android Auto) -->
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.CAR_LAUNCHER" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
                <category android:name="android.intent.category.APP_MAPS" />
            </intent-filter>
            <meta-data android:name="distractionOptimized" android:value="true" />
            <!-- "Hey Google, play … on TubeView" -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:theme="@style/Theme.TubeView.Player"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <!-- the music library cars browse and voice requests play from -->
        <service
            android:name=".CarMusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <service
            android:name=".MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
